# Database Connection URL (Supabase PostgreSQL)
DB_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Security
SECRET_KEY="healthcare-super-secure-production-secret-key-change-in-env-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Server Environment
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="production"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://healthcare-monitoring-system.vercel.app"
VERCEL_FRONTEND_URL="https://healthcare-monitoring-system.vercel.app"

# OTP Configuration
DEV_OTP_MODE=true
DEFAULT_DEV_OTP="123456"
OTP_EXPIRY_MINUTES=10

# Default Seed Credentials
DEFAULT_ADMIN_EMAIL="admin@healthcare.local"
DEFAULT_ADMIN_PHONE="9999999999"
DEFAULT_ADMIN_PASSWORD="Admin@Healthcare2026"

# Optional Cloudflare Tunnel Token (for 24/7 dedicated public HTTPS domain)
# CLOUDFLARE_TUNNEL_TOKEN=""
